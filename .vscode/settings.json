{
  "solargraph.diagnostics": true,

  // Ruby LSP runs its language server in a Ruby of its own choosing. Its default
  // `auto` mode looks for a supported version manager and reports errors when it
  // cannot find one, which is what happens on Windows unless you use one of the
  // managers it knows about. `none` means "use whatever `ruby` is on PATH", which
  // keeps this file free of machine specific paths.
  //
  // That Ruby needs to be 3.2 or newer, matching SketchUp 2024 and later. If your
  // default Ruby is older, or if a version manager puts batch shims ahead of it on
  // PATH, point Ruby LSP at a specific interpreter in your *user* settings:
  //
  //   "rubyLsp.rubyExecutablePath": "C:\\Ruby34-x64\\bin\\ruby.exe"
  //
  // Use `rubyLsp.rubyExecutablePath` rather than overriding
  // `rubyLsp.rubyVersionManager`: the manager setting is set below at *workspace*
  // scope, which takes precedence over user settings, so a user-level override of
  // it would be ignored. `rubyExecutablePath` is declared `scope: machine`, so it
  // can only be set per machine and this file never shadows it.
  //
  // This only affects language features. Debugging attaches over TCP and does not
  // depend on it. See DEBUGGING.md.
  "rubyLsp.rubyVersionManager": {
    "identifier": "none"
  },
  "cSpell.words": [
    "Commonmarker",
    "RuboCop",
    "SketchUp",
    "Solargraph",
  ],
}
